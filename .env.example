# Server
# NODE_ENV=production is set automatically by Render - leave unset locally.
PORT=5050
# Comma-separated list of allowed frontend origins in production, e.g.:
# CLIENT_ORIGIN=https://friday-networks.vercel.app,https://app.example.com
CLIENT_ORIGIN=http://localhost:5173

# MySQL (Sequelize)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=friday_networks
DB_USER=root
DB_PASSWORD=
# Set to "true" if your hosted MySQL provider requires TLS (PlanetScale, Aiven, etc.)
DB_SSL=false

# Gmail IMAP
# Use a Google App Password, not your normal password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_USER=your-inbox@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# How often to check the inbox for new job description emails (in minutes)
SYNC_INTERVAL_MINUTES=5

# How many days back to look on the very first sync
INITIAL_SYNC_LOOKBACK_DAYS=30

# Optional: AI filtering for emails that don't match the known JD template.
# Free API key from https://console.groq.com/keys - leave blank to disable
# (every email from an allowed sender is imported, as before).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
